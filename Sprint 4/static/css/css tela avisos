body{
  padding: 25px;
  background-color: #f6f6f7;
}
.title {
	color: #5C6AC4;
}
.caixa {
  margin-top: 10px;
        width: 300px;
        height: 150px;
        background-color: rgb(230, 229, 173);
        border: 2px solid rgb(255, 251, 0);
        border-radius: 10px;
        padding: 20px;
    }

.linha {
    display: flex;
    justify-content: center;
    gap: 20px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1px 8px;
  border-bottom: 1px solid rgb(158, 148, 177);
  ;
}

.botao{
  background-color: blue;
  color: white;
  width: 280px;
  justify-content: center;

}



.linha .caixa {
  height: auto;
  min-height: 150px;
}


.etiqueta {
  display: inline-block;
  padding: 2px 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: bold;
  background-color: rgba(0, 0, 0, 0.08);
  color: #555;
  vertical-align: middle;
}

.caixa.cancelamento {
  background-color: #fdeaea;
  border-color: #f3b6b6;
}

.caixa.recado {
  background-color: #ffffff;
  border-color: #e3e3e8;
}

.marcar-tudo {
  border: 1px solid #ddd;
  background-color: #fff;
  border-radius: 8px;
  padding: 8px 14px;
  cursor: pointer;
  font-size: 14px;
}

.rodape {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin-top: 40px;
  padding: 16px;
  border-top: 1px solid rgb(158, 148, 177);
}

.rodape-item {
  color: #555;
  font-size: 14px;
  cursor: pointer;
}
